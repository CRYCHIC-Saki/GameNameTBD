extends GutTest

func test_floor_kitchen_opens_without_a_shop_save() -> void:
	var shop := "user://shop-v1.json"
	var before := FileAccess.get_file_as_bytes(shop) if FileAccess.file_exists(shop) else PackedByteArray()
	var world := TDRestaurantWorld.new()
	add_child_autofree(world)
	await get_tree().physics_frame
	world.session = TDPhase3Session.new()
	assert_true(world.session.load_default().ok)
	var kitchen := TDFloorKitchen.new()
	add_child_autofree(kitchen)
	kitchen.open_for(world)
	await get_tree().process_frame
	assert_not_null(kitchen.kitchen)
	assert_true(kitchen.kitchen.world.service_door)
	assert_eq(kitchen.kitchen.world._back_button.text, "回餐厅")
	var after := FileAccess.get_file_as_bytes(shop) if FileAccess.file_exists(shop) else PackedByteArray()
	assert_eq(after, before)
	kitchen.close()

func test_orders_follow_the_earliest_seated_guest_for_that_dish() -> void:
	var board := TDFloorBoard.new()
	var first := board.open_ticket("tomato_egg", "番茄炒蛋", false, "seat-a", "甲")
	var second := board.open_ticket("tomato_egg", "番茄炒蛋", false, "seat-b", "乙")
	board.sync(first, "wait_serve", true, true, -1.0, -1.0)
	board.sync(second, "seat", false, true, -1.0, -1.0)
	var early := board.serve("tomato_egg", 80.0)
	assert_true(early.ok, early.message)
	assert_eq(String(early.data["id"]), first)
	var not_seated := board.serve("tomato_egg", 80.0)
	assert_false(not_seated.ok)
	assert_eq(not_seated.code, "NO_GUEST")
	board.sync(second, "wait_serve", true, true, -1.0, -1.0)
	var later := board.serve("tomato_egg", 71.0)
	assert_eq(String(later.data["id"]), second)
	assert_false(board.serve("tomato_egg", 71.0).ok)

func test_wrong_dish_deciding_and_refusal_do_not_feed_a_guest() -> void:
	var board := TDFloorBoard.new()
	var waiting := board.open_ticket("changfen", "肠粉", false, "seat-c", "丙")
	board.sync(waiting, "wait_serve", true, true, -1.0, -1.0)
	var wrong := board.serve("tomato_egg", 90.0)
	assert_false(wrong.ok)
	assert_eq(board.status_of(board.tickets[0]), "queued")
	var any_plate := board.serve("", 64.0)
	assert_eq(String(any_plate.data["id"]), waiting)
	var deciding := TDFloorBoard.new()
	var off_menu := deciding.open_ticket("kaoya", "烤鸭", true, "seat-d", "丁")
	deciding.sync(off_menu, "order", true, true, -1.0, -1.0)
	assert_eq(deciding.status_of(deciding.tickets[0]), "deciding")
	assert_false(deciding.serve("", 50.0).ok)
	assert_true(deciding.describe(deciding.tickets[0]).contains("菜单上没有"))
	deciding.mark_refused(off_menu)
	deciding.sync(off_menu, "leave", false, false, -1.0, -1.0)
	assert_eq(deciding.status_of(deciding.tickets[0]), "refused")
	assert_false(deciding.serve("", 50.0).ok)

func test_a_plate_stays_at_the_pass_until_it_is_carried_to_the_seat() -> void:
	var board := TDFloorBoard.new()
	var first := board.open_ticket("tomato_egg", "番茄炒蛋", false, "seat-a", "甲")
	var second := board.open_ticket("tomato_egg", "番茄炒蛋", false, "seat-b", "乙")
	board.sync(first, "wait_serve", true, true, -1.0, -1.0)
	board.sync(second, "wait_serve", true, true, -1.0, -1.0)
	var plated := board.hold_plate("tomato_egg", 88.0)
	assert_true(plated.ok, plated.message)
	assert_eq(String(plated.data["id"]), first)
	assert_eq(board.status_of(board.tickets[0]), "plated")
	assert_true(bool(board.tickets[0]["waiting"]))
	var next := board.hold_plate("tomato_egg", 70.0)
	assert_eq(String(next.data["id"]), second)
	assert_eq(String(board.pass_plate()["id"]), first)
	assert_true(board.claim_plate(first, "player").ok)
	assert_true(board.pass_plate().is_empty() or String(board.pass_plate()["id"]) == second)
	assert_eq(board.tick(10.0).size(), 0)
	assert_lt(float(board.tickets[0]["patience"]), TDFloorBoard.PATIENCE_SEC)
	var served := board.finish_plate(first)
	assert_true(served.ok, served.message)
	assert_eq(float(served.data["quality"]), 88.0)
	assert_false(board.finish_plate(first).ok)

func test_patience_runs_only_while_the_guest_is_waiting_to_be_served() -> void:
	var board := TDFloorBoard.new()
	var walking := board.open_ticket("tomato_egg", "番茄炒蛋", false, "seat-e", "戊")
	board.sync(walking, "seat", false, true, -1.0, -1.0)
	assert_eq(board.tick(500.0).size(), 0)
	assert_eq(float(board.tickets[0]["patience"]), TDFloorBoard.PATIENCE_SEC)
	board.sync(walking, "wait_serve", true, true, -1.0, -1.0)
	assert_eq(board.tick(179.0).size(), 0)
	assert_gt(float(board.tickets[0]["patience"]), 0.0)
	var left := board.tick(2.0)
	assert_eq(left, [walking])
	assert_eq(board.status_of(board.tickets[0]), "timed_out")
	assert_eq(board.tick(5.0).size(), 0)
	assert_true(board.describe(board.tickets[0]).contains("等不及"))
