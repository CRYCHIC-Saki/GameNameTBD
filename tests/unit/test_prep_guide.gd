extends GutTest

func test_the_tree_uses_each_recipes_chart_and_the_existing_unlock() -> void:
	var catalog := TDResearchCatalog.new()
	assert_true(catalog.load_file().ok)
	var session := TDResearchSession.new(catalog)
	var tomato := _joined(TDPrepGuide.recipe_lines(session, "C02"))
	assert_true(tomato.contains("开局就会"))
	assert_true(tomato.contains("切配"))
	assert_true(tomato.contains("番茄切块"))
	assert_true(tomato.contains("谱面接受"))
	assert_true(tomato.contains("见嫩就停"))
	assert_true(tomato.contains("可以买"))
	var noodles := _joined(TDPrepGuide.recipe_lines(session, "C03"))
	assert_true(noodles.contains("花灵感"))
	assert_true(noodles.contains("细面条"))
	assert_true(noodles.contains("清水"))
	assert_true(noodles.contains("不拿来切"))
	assert_false(noodles.contains("大块"))
	assert_true(TDPrepGuide.unlock_text("STORY_LOCKED", false).contains("剧情"))
	assert_true(TDPrepGuide.unlock_text("PREREQUISITES", false).contains("前置"))
	assert_true(TDPrepGuide.unlock_text("CHART_PENDING", false).contains("谱面"))
	assert_true(_joined(TDPrepGuide.recipe_lines(session, "C05")).contains("谱面"))
	assert_true(_joined(TDPrepGuide.recipe_lines(session, "C20")).contains("前置"))
	assert_true(_joined(TDPrepGuide.recipe_lines(session, "E01")).contains("剧情"))
	var salt := TDPrepGuide.food("salt")
	assert_false(salt.is_empty())
	assert_true(TDPrepGuide.obtain_text(salt, "UNLOCKED").contains("一直卖"))
	assert_true(TDPrepGuide.handling(salt).contains("不切"))
	assert_true(TDPrepGuide.handling_for_id("tomato", "tomato_egg").contains("番茄切块"))
	assert_true(TDPrepGuide.handling_for_id("cucumber", "test.cold_salad").contains("切条"))
	assert_false(session.has("C05"))

func _joined(lines: PackedStringArray) -> String:
	return " ".join(lines)
