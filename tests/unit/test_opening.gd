extends GutTest

func test_the_first_day_follows_the_script_and_keeps_one_payment() -> void:
	var opening := TDOpening.new()
	assert_false(opening.started())
	opening.begin()
	assert_eq(opening.beat, "arrive")
	var chen := opening.talk("chen", "灶间烟火", false, 80)
	chen.begin()
	assert_true(chen.full_text().contains("先让夜鸦"))
	assert_eq(opening.resolve([]).size(), 0)
	assert_eq(opening.beat, "arrive")
	var named := opening.talk("aling", "灶间烟火", false, 80)
	named.begin()
	assert_true(named.full_text().contains("长途车"))
	assert_eq(named.portrait_id, "page")
	named.skip()
	assert_true(named.pick("name"))
	assert_eq(opening.resolve(named.picks).size(), 0)
	assert_eq(opening.beat, "follow")
	assert_true(opening.quest(false).contains("跟随"))
	var refused := TDOpening.new()
	refused.begin()
	refused.resolve(["name"])
	var no_drop := refused.resolve(["refuse"])
	assert_false(no_drop.has("san"))
	assert_false(refused.tasted)
	assert_eq(refused.beat, "cook")
	var tasted := opening.talk("chen", "灶间烟火", false, 80)
	tasted.begin()
	tasted.skip()
	assert_true(tasted.pick("taste"))
	assert_true(tasted.full_text().contains("80 → 75"))
	assert_true(tasted.full_text().contains("至味降临"))
	var drop := opening.resolve(tasted.picks)
	assert_eq(int(drop.san), -5)
	assert_true(drop.has("grant"))
	assert_true(opening.tasted)
	assert_eq(opening.resolve(["taste"]).size(), 0)
	var waiting := opening.talk("aling", "灶间烟火", false, 75)
	waiting.begin()
	assert_true(waiting.full_text().contains("大块番茄"))
	opening.note_plate(40.0)
	assert_false(opening.good)
	var burnt := opening.talk("aling", "灶间烟火", false, 75)
	burnt.begin()
	assert_true(burnt.full_text().contains("破绽"))
	opening.note_plate(90.0)
	assert_true(opening.good)
	var served := opening.talk("aling", "灶间烟火", false, 75)
	served.begin()
	assert_true(served.full_text().contains("封存的记录"))
	assert_eq(served.portrait_id, "aling")
	served.skip()
	assert_true(served.pick("doubt"))
	var pay := opening.resolve(served.picks, false)
	assert_true(opening.doubted)
	assert_true(opening.owe_pay)
	assert_true(pay.has("pay"))
	assert_eq(opening.beat, "founded")
	var gap := opening.talk("aling", "灶间烟火", true, 75, {"menu": false, "price": false, "stock": false, "served": false})
	gap.begin()
	assert_true(gap.full_text().contains("菜单"))
	var sign := opening.talk("aling", "灶间烟火", true, 75, {"menu": true, "price": true, "stock": true, "served": false})
	sign.begin()
	sign.skip()
	assert_true(sign.pick("sign_home"))
	opening.resolve(sign.picks, false)
	assert_eq(opening.stall_sign, "家常菜")
	assert_eq(opening.beat, "founded")
	assert_eq(opening.resolve(["port"], false).size(), 0)
	assert_eq(opening.beat, "founded")
	var early := opening.talk("aling", "灶间烟火", false, 75)
	early.begin()
	early.skip()
	assert_false(early.choices_open)
	assert_true(early.full_text().contains("开门"))
	var later := opening.talk("aling", "灶间烟火", true, 75)
	later.begin()
	later.skip()
	assert_true(later.pick("port"))
	opening.resolve(later.picks, true)
	assert_true(opening.finished())
	opening.mark_paid()
	assert_false(opening.owe_pay)
	var saved := opening.export_state()
	var loaded := TDOpening.new()
	loaded.restore(saved)
	assert_eq(loaded.beat, "done")
	assert_true(loaded.paid)
	assert_true(loaded.good)
	loaded.restore({})
	assert_false(loaded.started())

func test_story_people_do_not_take_the_diner_door() -> void:
	var profile := TDGameProfile.new()
	assert_true(profile.error.ok, profile.error.code)
	profile.story.begin()
	var town := TDTownWorld.new()
	town.player_mode = true
	town.session = profile.world
	town.hero_name = "灶间烟火"
	town.story = profile.story
	add_child_autofree(town)
	await get_tree().process_frame
	var door := town._diner_door()
	for person: Variant in town._story_people():
		assert_ne((person as Dictionary).cell, door)
	var entered := []
	town.restaurant_requested.connect(func() -> void: entered.append(true))
	town._interact()
	var faced := town.facing_plot()
	assert_false(town._talk_open(), "cell %s facing %s plot %s" % [town._player_cell(), town._player.facing, faced.get("id", "")])
	assert_eq(entered.size(), 1, "cell %s facing %s plot %s" % [town._player_cell(), town._player.facing, faced.get("id", "")])
	assert_eq(town.story.beat, "arrive")
	profile.close()

func test_new_portraits_and_a_saved_chapter_roundtrip() -> void:
	var profile := TDGameProfile.new()
	assert_true(profile.error.ok, profile.error.code)
	assert_false(profile.snapshot().has("story"))
	profile.slot_id = "slot-01"
	profile.story.begin()
	profile.world.set_san(75)
	var before := int(profile.shop.snapshot().money_cents)
	var cents := int(profile.service.offer("service.tomato_egg").reference_cents)
	var token := "story-aling-tomato:%s" % str(profile.shop.snapshot().run_id)
	assert_true(profile.shop.world_adjustment(cents, token, "阿铃的审判").ok)
	assert_eq(profile.shop.world_adjustment(cents, token, "阿铃的审判").code, "DUPLICATE")
	assert_eq(int(profile.shop.snapshot().money_cents), before + cents)
	var saved := profile.snapshot()
	assert_eq(String(saved.story.beat), "arrive")
	var other := TDGameProfile.new()
	assert_true(other.restore(saved).ok)
	assert_eq(other.story.beat, "arrive")
	assert_eq(other.world.san, 75)
	var erased := saved.duplicate(true)
	erased.erase("story")
	var legacy := TDGameProfile.new()
	assert_true(legacy.restore(erased).ok)
	assert_false(legacy.story.started())
	profile.close()
	other.close()
	legacy.close()
	var layer := CanvasLayer.new()
	add_child_autofree(layer)
	var view := TDDialogueView.new()
	layer.add_child(view)
	await get_tree().process_frame
	var card := TDDialogue.new()
	card.add_line("罗厄", "luo", "唯有吾赐之味，值得渴求。")
	view.present(card)
	assert_eq(view.get_node("Portrait").get("who"), "luo")
