{
  "schema": 2,
  "active_roles": ["building", "supplier", "town-economy"],
  "roles": [
    {
      "id": "building",
      "name": "建筑系统",
      "branch_template": "work/building/phase-{phase}-wave-{wave}",
      "owned_patterns": [
        "src/buildings/*", "content/buildings/*", "assets/buildings/*",
        "src/town/town_map.gd", "src/town/town_map.gd.uid",
        "src/town/restaurant_sizes.gd", "src/town/restaurant_sizes.gd.uid",
        "src/restaurant/restaurant_layout.gd", "src/restaurant/restaurant_layout.gd.uid",
        "tests/unit/test_building_*", "tests/integration/test_building_*",
        "tests/unit/test_restaurant_layout.gd", "tests/unit/test_restaurant_layout.gd.uid",
        "docs/collaboration/work-items/building/*"
      ],
      "required_suites": ["all"]
    },
    {
      "id": "supplier",
      "name": "原料厂商",
      "branch_template": "work/supplier/phase-{phase}-wave-{wave}",
      "owned_patterns": [
        "src/suppliers/*", "content/suppliers/*", "assets/suppliers/*",
        "src/economy/supply_book.gd", "src/economy/supply_book.gd.uid",
        "tests/unit/test_supplier_*", "tests/integration/test_supplier_*",
        "tests/unit/test_supply_*", "tests/integration/test_supply_*",
        "docs/collaboration/work-items/supplier/*"
      ],
      "required_suites": ["all"]
    },
    {
      "id": "town-economy",
      "name": "小镇经济",
      "branch_template": "work/town-economy/phase-{phase}-wave-{wave}",
      "owned_patterns": [
        "src/town_economy/*", "content/town_economy/*", "assets/town_economy/*",
        "src/economy/economy_math.gd", "src/economy/economy_math.gd.uid",
        "tests/unit/test_town_economy_*", "tests/integration/test_town_economy_*",
        "docs/collaboration/work-items/town-economy/*"
      ],
      "required_suites": ["all"]
    },
    {
      "id": "cook",
      "name": "做菜与研发",
      "branch_template": "work/cook/phase-{phase}-wave-{wave}",
      "owned_patterns": [
        "src/cooking/*",
        "src/qte/*",
        "src/kitchen/*",
        "src/scoring/*",
        "src/content/*",
        "src/world/*",
        "assets/kitchen/*",
        "content/cooking_system.json",
        "content/cooking_prototype.json",
        "content/dev_samples.json",
        "content/research/*",
        "tests/unit/test_session.gd",
        "tests/unit/test_cooking_*",
        "tests/unit/test_full_cooking.gd",
        "tests/unit/test_pc_cooking.gd",
        "tests/unit/test_time_qte.gd",
        "tests/unit/test_full_qte.gd",
        "tests/unit/test_pc_operations.gd",
        "tests/unit/test_document_operations.gd",
        "tests/unit/test_recipe_performance.gd",
        "tests/unit/test_season_hold.gd",
        "tests/unit/test_customer_scoring.gd",
        "tests/unit/test_research_*",
        "tests/unit/test_san_substitute.gd",
        "tests/integration/test_kitchen_*",
        "tests/integration/test_full_kitchen.gd",
        "tests/integration/test_pc_kitchen.gd",
        "tests/integration/test_guided_kitchen.gd",
        "tests/integration/test_cooking_action_view.gd",
        "docs/collaboration/work-items/cook/*"
      ],
      "required_suites": [
        "cooking",
        "qte",
        "scoring"
      ]
    },
    {
      "id": "economy",
      "name": "经济与供货",
      "branch_template": "work/economy/phase-{phase}-wave-{wave}",
      "owned_patterns": [
        "src/economy/*",
        "src/business/*",
        "content/pantry.json",
        "content/ingredient_index.json",
        "content/markets/*",
        "content/seasonings/*",
        "content/store_types/*",
        "content/brand/*",
        "tests/unit/test_shop_*",
        "tests/unit/test_kitchen_freedom.gd",
        "tests/unit/test_economy_*",
        "tests/unit/test_market_*",
        "tests/unit/test_supply_*",
        "tests/unit/test_brand_*",
        "tests/integration/test_shop_application.gd",
        "tests/integration/test_economy_*",
        "docs/collaboration/work-items/economy/*"
      ],
      "required_suites": [
        "business",
        "platform"
      ]
    },
    {
      "id": "town",
      "name": "小镇与事件",
      "branch_template": "work/town/phase-{phase}-wave-{wave}",
      "owned_patterns": [
        "src/restaurant/*",
        "src/town/*",
        "assets/town/*",
        "content/events/*",
        "content/towns/*",
        "content/decorations/*",
        "tests/unit/test_floor_service.gd",
        "tests/unit/test_restaurant_layout.gd",
        "tests/unit/test_town_*",
        "tests/unit/test_event_*",
        "tests/integration/test_phase3_visit.gd",
        "tests/integration/test_restaurant_world.gd",
        "tests/integration/test_town_*",
        "tests/integration/test_event_*",
        "docs/collaboration/work-items/town/*"
      ],
      "required_suites": [
        "service"
      ]
    }
  ],
  "shared_patterns": [
    "AGENTS.md",
    "README.md",
    "project.godot",
    "export_presets.cfg",
    "dependencies.lock.json",
    "collaboration.config.json",
    ".github/*",
    "tools/*",
    "dev/*",
    "src/app/*",
    "src/contracts/*",
    "src/platform/*",
    "src/town/phase3_session.gd",
    "src/town/phase3_session.gd.uid",
    "src/town/san_rules.gd",
    "src/town/san_rules.gd.uid",
    "content/phase3_world.json",
    "content/service_content.json",
    "content/active_content.json",
    "tests/unit/test_phase3_rules.gd",
    "tests/unit/test_phase4_branch.gd",
    "tests/unit/test_content.gd",
    "tests/unit/test_full_catalog.gd",
    "tests/unit/test_recipe_content.gd",
    "tests/unit/test_storage_scoring.gd",
    "tests/unit/test_full_storage_scoring.gd",
    "tests/integration/test_game_shell.gd",
    "tests/integration/test_title_entry.gd",
    "tests/integration/test_application.gd",
    "tests/integration/test_cooking_application.gd",
    "docs/ARCHITECTURE.md",
    "docs/CONTRACTS.md",
    "docs/COLLABORATION.md",
    "docs/DECISIONS.md",
    "docs/DEVELOPMENT_PROTOCOL.md",
    "docs/PROJECT_STATE.md",
    "docs/ROADMAP.md",
    "docs/SOURCES.md",
    "docs/FULL_IMPLEMENTATION_FLOW.md",
    "docs/AI_FILLED_DETAILS.md",
    "docs/PHASE1_INTERFACES.md",
    "docs/PLAYTEST.md",
    "docs/systems/*",
    "docs/phases/*",
    "docs/collaboration/README.md",
    "docs/collaboration/CURRENT_WAVE.md",
    "docs/collaboration/work-items/README.md",
    "docs/collaboration/templates/*",
    "doc/agent_prompts/*"
  ],
  "integration_branch_template": "integration/phase-{phase}-wave-{wave}",
  "default_worktree_root": "../GameNameTBD-worktrees"
}
