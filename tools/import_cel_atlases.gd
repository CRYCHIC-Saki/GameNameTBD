extends SceneTree
## Only adapts generated art to the existing atlas canvas and clips overflow.
## Artwork is generated by imagegen. No map coordinates or physics are edited.
func _initialize() -> void:
	var rows: Array = JSON.parse_string(FileAccess.get_file_as_string("res://artifacts/story-revision-20261126/generated-atlases.json"))
	for row: Dictionary in rows:
		var target: String = "res://" + row.target
		var backup := "res://artifacts/story-revision-20261126/original-atlases/" + str(row.target).get_file()
		DirAccess.make_dir_recursive_absolute(backup.get_base_dir())
		if not FileAccess.file_exists(backup):
			if DirAccess.copy_absolute(target,backup) != OK: quit(1); return
		var original := Image.load_from_file(backup)
		var generated := Image.load_from_file(row.generated)
		if original == null or generated == null: quit(1); return
		original.convert(Image.FORMAT_RGBA8); generated.convert(Image.FORMAT_RGBA8)
		if row.get("fit_visible",false):
			generated = generated.get_region(generated.get_used_rect())
			var bounds := original.get_used_rect()
			generated.resize(bounds.size.x,bounds.size.y,Image.INTERPOLATE_LANCZOS)
			var canvas := Image.create(original.get_width(),original.get_height(),false,Image.FORMAT_RGBA8)
			canvas.blit_rect(generated,Rect2i(Vector2i.ZERO,bounds.size),bounds.position)
			generated = canvas
		else: generated.resize(original.get_width(),original.get_height(),Image.INTERPOLATE_LANCZOS)
		var original_bytes := original.get_data()
		var output := generated.get_data()
		for alpha: int in range(3, output.size(),4):
			output[alpha] = mini(output[alpha],original_bytes[alpha])
		var final := Image.create_from_data(original.get_width(),original.get_height(),false,Image.FORMAT_RGBA8,output)
		if final.save_png(target) != OK: quit(1); return
		print("ATLAS_CANVAS ",row.id," size=",final.get_size()," overflow_alpha=0")
	quit(0)
